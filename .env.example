# bhatti.sh — environment variables.
# Copy to .env (gitignored) for local builds, or set in your
# Cloudflare Pages / Workers project for production.

# Path the browser fetches the Umami tracker from. Same-origin: the
# Cloudflare Worker (worker/index.js) proxies this to the self-hosted
# Umami at mymami.sahil-shubham.in under the hood, so ad-blockers see
# a same-origin request and don't strip the tracker.
PUBLIC_UMAMI_SCRIPT_URL=/cf/script.js

# Website ID from the Umami dashboard → website settings → Edit.
PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
